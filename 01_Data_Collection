# Stage 1] 이원적 데이터 수집 모듈 (Data Collection)
import requests
import json
import pandas as pd
import re
import time
import random
from bs4 import BeautifulSoup
from selenium import webdriver
from selenium.webdriver.chrome.options import Options

def collect_naver_news_urls(query, start_date, end_date, max_pages=3): # 1. 뉴스 기사 URL 수집 함수 (Selenium)
    print(f"\n[URL 수집] '{query}' 뉴스 링크 수집을 시작합니다. (목표: {max_pages}쪽)")
    options = Options() #Selenium으로 조종할 크롬 브라우저의 '환경설정(옵션)' 객체를 생성
    options.add_argument("disable-blink-features=AutomationControlled") #크롬의 렌더링 엔진(Blink)에게 "이 브라우저가 자동화 소프트웨어에 의해 제어되고 있다는 티를 내지 마
    options.add_argument("user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36") #"나는 평범한 윈도우 10 PC에서 크롬(버전 124) 브라우저를 쓰는 일반 사람이야"라고 서버를 속이는 역할
    
    driver = webdriver.Chrome(options=options) #driver 정의 실제 브라우저 실행 및 조종간 획득
    collected_urls = []

    for page in range(1, max_pages + 1):
        start_val = (page - 1) * 10 + 1
        search_url = f"https://search.naver.com/search.naver?where=news&query={query}&sort=2&pd=3&ds={start_date}&de={end_date}&start={start_val}"
        driver.get(search_url) #크롬 브라우저 주소창에 이 주소를 입력하고 엔터 쳐서 들어가
        time.sleep(random.uniform(1.95, 2.99))
        
        soup = BeautifulSoup(driver.page_source, 'html.parser')
        links = soup.find_all("a") #화면 안의 모든 '링크(Link)' 싹쓸이
        for link in links:
            href = link.get('href', '') #href 없는 경우 ''로 바꾸는 방어적 코드
            if "n.news.naver.com" in href and "article" in href: #댓글을 수집해야 하므로 네이버 포털 내부기사만 + 수집 실제 article이 포함되는 경우만
                collected_urls.append(href)
                
        print(f"  - 검색결과 {page}페이지 완료 (현재 확보된 고유 기사: {len(set(collected_urls))}개)")
        
    driver.quit()
    unique_urls = list(set(collected_urls))
    return unique_urls

# 2. 뉴스 기사 본문 수집 함수 (멀티 셀렉터 Fallback 적용)
def get_naver_news_article(news_url, session): #request.Session()은 get()과 달리 연결을 끊지 않고 유지
    try: #일단 아래 코드를 실행해보되, 에러가 나더라도 전체를 다운시키지 말고 예외 처리로 넘어가라
        response = session.get(news_url, timeout=5) #기사주소로 접속하되, 5초가 지나면 포기하고 끊어라
        response.encoding = 'utf-8'  # 인코딩 명시적 지정, 한글 깨짐 방지
        
        soup = BeautifulSoup(response.text, 'html.parser') #HTML 원본을 구조화된 트리 형태(soup)로 예쁘게 파싱

        # 제목 추출 (대체 셀렉터 포함)
        title_tag = soup.select_one('h2#title_area') or soup.select_one('h3.tts_head') or soup.select_one('div.media_end_head_title') #찾다가 하나라도 발견되면 값을가져옴
        title = title_tag.text.strip() if title_tag else '' #만약 끝내 못 찾았다면(else), 에러를 내지 말고 그냥 빈칸('')으로 둬라.
        
        # 본문 추출 (다양한 네이버 뉴스 레이아웃 대응을 위한 Fallback 셀렉터 리스트)
        body_tag = None
        body_selectors = ['div#dic_area', 'div.newsct_article', 'div#articleBodyContents', 'article.go_trans'] #본문선택 좌표
        for selector in body_selectors:
            body_tag = soup.select_one(selector)
            if body_tag and len(body_tag.text.strip()) > 0:
                break #태그를 찾았고(body_tag), 그 안의 글자 수가 0보다 크면(즉, 내용이 텅 비어있지 않으면) 성공이므로 즉시 반복문을 탈출
                
        body = body_tag.text.strip() if body_tag else '' #찾아낸 본문 태그에서 텍스트만 추출하고 앞뒤 공백을 제거
        
        press_tag = soup.select_one('a.media_end_head_top_logo img') #언론사 이미지 찾고, 
        press = press_tag.get('title', '') if press_tag else '' #이미지태그의 title을 빼냄
        if not press: #로고 이미지 대신 텍스트로만 언론사 이름이 적힌 곳
            press_tag_alt = soup.select_one('em.media_end_head_top_logo_text') #텍스트 위치(em...)를 찔러서 언론사 이름을 긁어옴
            press = press_tag_alt.text.strip() if press_tag_alt else '' 
            
        date_tag = soup.select_one('span.media_end_head_info_datestamp_time') # 날짜 추출
        date = date_tag.get('data-date-time', date_tag.text.strip()) if date_tag else ''  #절대 시간(data-date-time)
        
        if not title or not body:
            print(f"    [DEBUG] title='{title[:30]}' / body_len={len(body)} → 필수 요소 누락으로 실패")
            return None
            
        return {
            'origin_news_url': news_url,
            'press': press,
            'title': title,
            'body': body,
            'date': date
        }
    except Exception as e:
        print(f"    [DEBUG] 예외 발생: {type(e).__name__}: {e}")
        return None

# 3. 뉴스 댓글 수집 함수 (API jsonp 파싱)
def get_naver_comments_api(news_url, session):  #정규표현식(Regex)을 이용한 암호 해독
    match = re.search(r'article/(\d+)/(\d+)', news_url) #네이버 뉴스 주소는 항상 .../article/023(언론사번호)/000381923(기사번호) 형태
    if not match:
        return pd.DataFrame() #방어적 코딩
        
    oid, aid = match.groups() #oid(언론사 ID), aid(기사 ID)
    object_id = f"news{oid},{aid}" #네이버 댓글 API가 요구하는 고유한 포맷인 news023,000381923 형태로 암호를 조립
    
    try: #쿠키(Cookie) 굽기 (사전 작업)
        session.get(news_url, timeout=5)  
    except:
        pass
        
    headers = {"Referer": news_url}
    api_url = "https://apis.naver.com/commentBox/cbox/web_naver_list_jsonp.json"
    comments_data = []
    page = 1
    seen_comment_ids = set()
    
    while True: #무한 댓글 수집 루프 (API 호출)
        params = {
            'ticket': 'news',
            'templateId': 'default_society',
            'pool': 'cbox5',
            'lang': 'ko',
            'country': 'KR',
            'objectId': object_id, #기사 고유 번호
            'pageSize': 100,      #한 번에 최대치인 100개씩 꽉꽉 눌러 담아줘
            'page': page, #페이지 1부터 시작해서 밑에서 루프마다 +=1함
            'sort': 'NEW',   #최신순, CCF 분석을 위해 시간순 정렬이 필수
            'cleanbot': 'false'    #네이버의 '클린봇(욕설 필터링)'을 끔
        }
        
        try:
            response = session.get(api_url, headers=headers, params=params, timeout=5) #준비한 주문서(params)와 출입증(headers)을 들고 비밀 창고(api_url)에 요청
            json_text = re.sub(r'^[^(]*\((.*)\)[^)]*$', r'\1', response.text)#re.sub(...): 정규표현식을 써서 괄호 ( ) 바깥에 있는 포장지를 잘라내고, 안쪽에 있는 순수 알맹이(JSON 데이터)만 추출.
            data = json.loads(json_text) #텍스트 형태의 알맹이를 파이썬이 다루기 쉬운 사전(Dictionary) 형태로 변환
            
            comments_list = data.get('result', {}).get('commentList', []) #"result": {"commentList": [{"commentNo": 123, "contents": "첫 번째 댓글입니다."}, {"commentNo": 124, "contents": "두 번째 댓글입니다."}]
            if not comments_list: 
                break
                
            new_comments_count = 0
            for comment in comments_list:
                comment_no = comment['commentNo'] #고유번호
                if comment_no in seen_comment_ids: 
                    continue #다음 댓글로 넘어가라
                seen_comment_ids.add(comment_no)
                new_comments_count += 1 
                
                if comment['deleted']: #삭제된댓글
                    continue #다음댓글로 넘어가
                    
                comments_data.append({ #네이버 API가 쓰는 복잡한 이름표를 우리가 쓰기 편한 직관적인 이름으로 바꿈
                    'comment_no': comment_no,
                    'date': comment['regTime'], #작성시간
                    'text': comment['contents'], #댓글본문
                    'sympathy_count': comment['sympathyCount'], #공감
                    'antipathy_count': comment['antipathyCount'], #비공감
                    'origin_news_url': news_url #출처 url
                })
            
            if new_comments_count == 0:
                break
            
            page += 1
            time.sleep(random.uniform(0.3,0.309))
            
        except Exception as e:
            break

    return pd.DataFrame(comments_data)

# 4. 통합 실행 파이프라인
SEARCH_KEYWORDS = {
    "묻지마 범죄": {"start": "2003.01.01", "end": "2025.12.31"}, #200 = 2011년
    "이상동기 범죄": {"start": "2022.01.01", "end": "2025.12.31"}
}
SEARCH_PAGES = 200

all_news_df = pd.DataFrame()     # 기사 본문 누적용 DF
all_comments_df = pd.DataFrame() # 댓글 누적용 DF

# 전역 세션(Session) 설정
global_session = requests.Session()
global_session.headers.update({ #requests 라이브러리가 기본적으로 챙겨주는 '필수 통신 장비(기본 헤더)'들을 다 버리지 않고, 우리가 속이고 싶은 '신분증(User-Agent)'만 쏙 교체
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
})

for keyword, date_range in SEARCH_KEYWORDS.items():
    start_date = date_range["start"]
    end_date = date_range["end"]
    print(f"\n[{keyword}] 키워드 데이터 파이프라인 가동! (수집기간: {start_date} ~ {end_date})")
    
    news_urls = collect_naver_news_urls(query=keyword, start_date=start_date, end_date=end_date, max_pages=SEARCH_PAGES) #뉴스 url 함수
    
    if news_urls:
        print(f"[데이터 수집] '{keyword}' 관련 기사 본문 및 댓글을 이원 수집합니다...")
        
        for i, url in enumerate(news_urls):
            print(f"  [{i+1}/{len(news_urls)}] 진행 중... (URL: {url})")
            
            article_data = get_naver_news_article(url, global_session) # 1) 기사 본문 수집
            if article_data:
                article_data['Search_Keyword'] = keyword #키워드 column 생성
                all_news_df = pd.concat([all_news_df, pd.DataFrame([article_data])], ignore_index=True)
                
                df_temp = get_naver_comments_api(url, global_session)  # 2) 해당 기사의 댓글 수집
                if not df_temp.empty:
                    df_temp['Search_Keyword'] = keyword
                    all_comments_df = pd.concat([all_comments_df, df_temp], ignore_index=True)
                    print(f" ↳성공: 기사 본문 수집 완료 / 댓글 {len(df_temp)}개 수집")
                else:
                    print(" ↳성공: 기사 본문 수집 완료 / 댓글 없음")
            else:
                print(" ↳실패: 기사 본문을 불러오지 못했습니다.")
            
            time.sleep(random.uniform(0.37,0.43))
    else:
        print(f"'{keyword}'에 대한 기사 링크를 찾지 못했습니다.")

# 5. 최종 데이터 정제 및 이원화 저장
print("\n수집 완료! 데이터를 정제하고 분리 저장합니다.")

# (1) 뉴스 기사 데이터(공식 담론) 저장
if not all_news_df.empty:
    all_news_df = all_news_df.drop_duplicates(subset=['origin_news_url'], keep='first').reset_index(drop=True)
    all_news_df.to_csv("news_raw_data.csv", index=False, encoding='utf-8-sig')
    print(f"[✅ 뉴스 기사] 총 {len(all_news_df)}건 -> 'news_raw_data.csv' 저장 완료")
else:
    print("[-] 수집된 뉴스 기사가 없습니다.")

# (2) 댓글 데이터(대중 텐션) 저장
if not all_comments_df.empty:
    all_comments_df['date'] = pd.to_datetime(all_comments_df['date'])
    all_comments_df = all_comments_df.sort_values(by='date').reset_index(drop=True)
    all_comments_df = all_comments_df.drop_duplicates(subset=['text'], keep='first')
    all_comments_df.to_csv("comments_raw_data.csv", index=False, encoding='utf-8-sig')
    print(f"[✅ 댓글 데이터] 총 {len(all_comments_df)}건 -> 'comments_raw_data.csv' 저장 완료")
else:
    print("[-] 수집된 댓글 데이터가 없습니다.")
