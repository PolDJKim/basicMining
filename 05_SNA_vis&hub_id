# Stage 5: SNA 및 뇌관 추출 모듈 (Optimized Version)
import pandas as pd
import ast
import numpy as np
import networkx as nx
from sklearn.feature_extraction.text import CountVectorizer
import warnings
warnings.filterwarnings('ignore')

print("[뉴스 기사/댓글] Stage 5: 최적화된 네트워크 분석(SNA) 및 핵심 뇌관 식별 가동!")
try: # 1. 전처리 데이터 로드 (뉴스 및 댓글 통합 또는 개별 처리)
    news_df = pd.read_csv("news_preprocessed.csv")
    print(f"  - 뉴스 데이터를 성공적으로 불러왔습니다. (총 {len(news_df)}건)")
except FileNotFoundError:
    print("  - [오류] 'news_preprocessed.csv' 파일을 찾을 수 없습니다. 2단계를 먼저 실행해주세요.")
    exit()

def parse_tokens(x): # 문자열 리스트 변환 함수
    try:
        return ast.literal_eval(x)
    except:
        return []

news_df['tokens'] = news_df['tokens'].apply(parse_tokens)
news_df = news_df[news_df['tokens'].map(len) > 0] # [] 삭제

# 2. 핵심 노드 수 제한을 위한 상위 빈도 단어 필터링 (속도 최적화 핵심)
MAX_FEATURES = 300  # 연산 폭증 방지를 위해 상위 300개 키워드로 제한
print(f" 상위 빈도 기준 상위 {MAX_FEATURES}개의 키워드로 네트워크 노드를 제한합니다.")

docs = news_df['tokens'].apply(lambda x: ' '.join(x)) #def는 정규직 lambda는 일용직
vectorizer = CountVectorizer(max_features=MAX_FEATURES, min_df=2)
X = vectorizer.fit_transform(docs)
feature_names = vectorizer.get_feature_names_out() #이름표 뽑아내기, 네트워크 그래프를 그릴 때 각각의 '노드(점)' 이름으로 그대로 사용

print("동시출현 행렬(Co-occurrence Matrix) 구축 중...") # 3. 동시출현 행렬(Co-occurrence Matrix) 구축
co_occurrence_matrix = (X.T * X).toarray() #X.T는 뒤집기, + *X (행렬 곱셈): 옆으로 눕힌 표(X.T)와 원래 표(X)를 곱해버림, 이후 array로 만듦(일반 표로 변신)
np.fill_diagonal(co_occurrence_matrix, 0) # 자기 자신과의 동시출현 제외

print("NetworkX 그래프 생성 및 중심성(연결정도·매개) 연산 중...") # 4. NetworkX 그래프 생성 및 중심성 분석
G = nx.Graph() # networkx 네트워크 전문 화가(라이브러리)의 '새 도화지' 준비하기 

n_features = len(feature_names) # 노드 및 엣지 추가 (등장인물(점) 몇 명인지 세기)
for i in range(n_features): #1번 손님(i=0)은 2번부터 300번 손님(j=1~299)과 쭉 악수
    for j in range(i + 1, n_features): #2번 손님(i=1)은 1번 손님과 다시 악수할 필요가 없고 3번부터 300번 손님(j=2~299)까지만 악수
        weight = co_occurrence_matrix[i, j] #두 단어(i번 단어와 j번 단어)가 몇 번이나 같이 등장했는지 그 점수를 가져와 weight(가중치)라고 부름
        if weight > 0: #만약 두 단어가 단 한 번이라도 같이 등장한 적이 있다면
            G.add_edge(feature_names[i], feature_names[j], weight=weight) #도화지(G)에 두 단어 이름(i와 j)으로 점을 찍고, 두 점 사이에 선(edge)을 그어줘! 그리고 그 선 위에 친밀도 점수(weight)도 숫자표로 달아놔

G.remove_nodes_from(list(nx.isolates(G))) # 고립된 노드 제거 (다른 단어와 한번도 같이 등장한 적이 없어서 연결선이 아예 없는)

if len(G.nodes) > 0: #안전 점검 (빈 도화지 방지)
    degree_centrality = nx.degree_centrality(G) #연결중심성 지표 계산(마당발 인싸 지수)
    betweenness_centrality = nx.betweenness_centrality(G, weight='weight') #매개중심성 지표 계산(환승역 지수)

    centrality_df = pd.DataFrame({ # 결과 데이터프레임 정리
        'Keyword': list(G.nodes),
        'Degree_Centrality': [degree_centrality[node] for node in G.nodes], #노드를 불러와서 연결중심성 점수만 쏙 읽어와
        'Betweenness_Centrality': [betweenness_centrality[node] for node in G.nodes] #노드를 불러와서 매개중심성 점수만 쏙 읽어와
    })
    centrality_df['Hub_Score'] = (    # 복합 영향력 지표 산출 (연결정도 + 매개중심성 가중 합산)
        centrality_df['Degree_Centrality'] * 0.5 + centrality_df['Betweenness_Centrality'] * 0.5
    )
    centrality_df = centrality_df.sort_values(by='Hub_Score', ascending=False).reset_index(drop=True) # 핵심 뇌관 키워드 순위 정렬

    centrality_df.to_csv("hub_monthly_trends.csv", index=False, encoding='utf-8-sig') # 체크포인트 저장
    print(f"[✅ 완료] 상위 {len(centrality_df)}개 핵심 노드 분석 완료")
    print("상위 5대 핵심 뇌관 키워드:")
    print(centrality_df.head(5)[['Keyword', 'Hub_Score']])
    print("결과 파일 저장 완료: 'hub_monthly_trends.csv'")
else:
    print("경고: 네트워크를 구성할 충분한 동시출현 관계가 발견되지 않았습니다.")
